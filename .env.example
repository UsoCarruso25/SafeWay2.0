# Copia este archivo como ".env" (no lo subas a git) y pega tu token público de Mapbox.
# Consíguelo gratis en https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.TU_TOKEN_PUBLICO_AQUI

# Cuando exista backend (segunda etapa), la URL base de la API se define aquí:
VITE_API_BASE_URL=http://localhost:4000/api
